# ==============================================================================
# Chandrapur Land Governance Platform - Backend Environment Template
# Duplicate this file to '.env' and fill in your actual credentials.
# NEVER commit '.env' with real secrets to GitHub or source control!
# ==============================================================================

# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (PostgreSQL / Neon Cloud / Supabase)
# Pooled connection string:
DATABASE_URL="postgresql://username:password@ep-round-bread-pooler.region.neon.tech/neondb?sslmode=require"

# Direct / unpooled connection string (required for migrations if using connection pooler):
DATABASE_URL_UNPOOLED="postgresql://username:password@ep-round-bread.region.neon.tech/neondb?sslmode=require"

# CORS Configuration (CRITICAL FOR DEPLOYMENT)
# Comma-separated list of allowed frontend domains.
# In local dev: "http://localhost:3000,http://127.0.0.1:3000"
# In production: Set to your deployed frontend domain, e.g.:
# CORS_ORIGIN="https://chanda.vercel.app,https://yourdomain.com"
CORS_ORIGIN="http://localhost:3000,http://127.0.0.1:3000"

# Optional: Set to true to automatically authorize Vercel preview branch deployments (*.vercel.app)
ALLOW_VERCEL_PREVIEWS=true

# Cloudinary DMS (Document Management System) Credentials
CLOUDINARY_URL="cloudinary://your_api_key:your_api_secret@your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_FOLDER="chanda_land_dms"
