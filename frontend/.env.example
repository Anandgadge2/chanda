# ==============================================================================
# Chandrapur Land Governance Platform - Frontend Environment Template
# Duplicate this file to '.env.local' for local development.
# In Vercel / Netlify / Cloudflare Pages, configure this in Project Environment Variables!
# NEVER commit '.env.local' to GitHub or source control!
# ==============================================================================

# Backend API Endpoint URL
# Local development:
NEXT_PUBLIC_API_URL=http://localhost:5000

# In production deployment (e.g. on Render, Railway, Fly.io, or VPS):
# NEXT_PUBLIC_API_URL=https://your-backend-api.onrender.com
