    "react-slick": "^0.31.0",
    "recharts": "^3.10.1",
    "slick-carousel": "^2.0.0",
    "tailwind-merge": "^2.5.4"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15"
  }
